# Copy to .env (scripts/setup-env.mjs does it in M0-03). Every variable is validated at boot (src/platform/config.ts).
NODE_ENV=development
APP_ENV=local
PORT=3000
LOG_LEVEL=debug
# Exact origin of the admin app (CORS and CSRF)
ADMIN_ORIGIN=http://localhost:5173
# Number of proxies in front of the API (0 locally)
TRUST_PROXY_HOPS=0
# The database (MySQL 8.x, native install). node scripts/setup-env.mjs generates the passwords and the SQL that creates the users.
# Read from task M0-06 onward.
DATABASE_URL=mysql://rubaya_app:__APP_DB_PASSWORD__@localhost:3306/rubaya
DATABASE_MIGRATION_URL=mysql://rubaya_migrate:__MIGRATE_DB_PASSWORD__@localhost:3306/rubaya
DB_POOL_SIZE=10
# Encrypts staff TOTP secrets (AES-256-GCM): 32 random bytes, base64. Losing it disables 2FA for everyone; rotating needs a re-encrypt (DOC-11 section 3.3).
DATA_ENCRYPTION_KEY=__DATA_ENCRYPTION_KEY__
# Name of the staff session cookie. The __Host- prefix needs HTTPS, so local development uses a plain name.
SESSION_COOKIE_NAME=rb_admin_dev
