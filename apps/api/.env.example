# Copy to .env (scripts/setup-env.mjs does it in M0-03). Every variable is validated at boot (src/platform/config.ts).
NODE_ENV=development
APP_ENV=local
PORT=3000
LOG_LEVEL=debug
# Exact origin of the admin app (CORS and CSRF)
ADMIN_ORIGIN=http://localhost:5173
# Shared secret of the storefront server (header X-Internal-Key). With it the API trusts the client address the storefront forwards; without it, the socket address.
INTERNAL_KEY=__INTERNAL_KEY__
# Number of proxies in front of the API (0 locally)
TRUST_PROXY_HOPS=0
# The database (MySQL 8.x, native install). node scripts/setup-env.mjs generates the passwords and the SQL that creates the users.
# Read from task M0-06 onward.
DATABASE_URL=mysql://rubaya_app:__APP_DB_PASSWORD__@localhost:3306/rubaya
DATABASE_MIGRATION_URL=mysql://rubaya_migrate:__MIGRATE_DB_PASSWORD__@localhost:3306/rubaya
DB_POOL_SIZE=10
# Encrypts staff TOTP secrets (AES-256-GCM): 32 random bytes, base64. Losing it disables 2FA for everyone; rotating needs a re-encrypt (DOC-11 section 3.3).
DATA_ENCRYPTION_KEY=__DATA_ENCRYPTION_KEY__
# Name of the staff session cookie. The __Host- prefix needs HTTPS, so local development uses a plain name.
SESSION_COOKIE_NAME=rb_admin_dev
# Files (development: a folder on this machine; the API serves uploads and generated sizes itself). Defaults shown; uncomment to change.
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.data/storage
# API_PUBLIC_URL=http://localhost:3000
# IMG_BASE_URL=http://localhost:3000/img
# Owners and managers must use two-step sign-in (default 1). 0 is accepted only when APP_ENV is local or ci.
# TWO_FACTOR_REQUIRED=1

# Local development only (refused unless APP_ENV=local): accept any password of 5 or more characters instead of the 12-character rules.
# RELAXED_PASSWORDS=0
# Secret for the order tracking links (32+ characters). Local and CI derive one when it is missing.
# TRACKING_KEY=

# Email (DOC-12 section 7). Empty = nothing is sent; messages are only written to notification_log. Locally: smtp://127.0.0.1:1025 (Mailpit)
# MAIL_URL=
MAIL_FROM=Rubaya <no-reply@rubaya.pk>

# Order messages to the customer's phone (SMS or WhatsApp) through ONE gateway: a JSON POST {to, text, reference} with `Authorization: Bearer <key>` (plan/12 section 4.4).
# Empty = nothing leaves the server; the messages are only written to notification_log. Staff also switch it on in Settings > Emails > Phone messages.
# MESSAGE_GATEWAY_URL=
# MESSAGE_GATEWAY_KEY=

# Background jobs (picture processing, search repair, order messages). Locally the API runs them itself (DEV_INLINE_WORKER defaults to 1
# when APP_ENV is local or ci); anywhere else run `node src/worker.js` as its own process, or uploads stay "processing" and the admin shows a warning.
# DEV_INLINE_WORKER=1
# How long a picture upload waits for its own processing before it answers "still processing" and leaves the rest to the worker (milliseconds).
# MEDIA_INLINE_BUDGET_MS=6000
