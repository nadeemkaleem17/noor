{
  "name": "@noor/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Rubaya API: Fastify modular monolith (plan/08-backend-architecture.md).",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.js",
    "start": "node --env-file-if-exists=.env src/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "spike:drizzle": "node --env-file-if-exists=.env spikes/m0-06-drizzle.js",
    "spike:jobs": "node --env-file-if-exists=.env spikes/m0-07-jobs.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "cli": "node --env-file-if-exists=.env src/cli.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/swagger": "~9.9.0",
    "@node-rs/argon2": "^2.2.1",
    "@noor/contract": "workspace:*",
    "drizzle-orm": "~0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "mysql2": "^3.24.4",
    "otplib": "^13.5.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@noor/config": "workspace:*",
    "@types/node": "^24",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.10.0",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
