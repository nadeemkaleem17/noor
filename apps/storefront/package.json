{
  "name": "@noor/storefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Rubaya storefront: React Router 8 framework mode, server rendered (plan/06-storefront, ADR-0004).",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "typecheck": "react-router typegen && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@noor/contract": "workspace:*",
    "@noor/i18n": "workspace:*",
    "@noor/ui": "workspace:*",
    "@react-router/node": "~8.4.0",
    "@react-router/serve": "~8.4.0",
    "i18next": "^26.4.2",
    "isbot": "^5.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-router": "~8.4.0"
  },
  "devDependencies": {
    "@noor/config": "workspace:*",
    "@react-router/dev": "~8.4.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
