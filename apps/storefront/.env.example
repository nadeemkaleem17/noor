# Copy to .env. Validated at boot (app/lib/env.server.ts); a missing value stops the server and names the variable.
NODE_ENV=development
PORT=5174
# API base URL as the storefront server reaches it. Never sent to the browser.
API_INTERNAL_URL=http://localhost:3000
# Public origin of this site: canonical URLs, sitemap, Open Graph
PUBLIC_SITE_URL=http://localhost:5174
# Image host: used in the CSP img-src and for image URLs
PUBLIC_IMG_URL=http://localhost:3000/img
