# Base URL of the store API (see ../mock-api). Leave empty to run on the built-in mock catalog.
# Local: copy this file to .env.local and set e.g. VITE_API_URL=http://localhost:3000
# Render: set it on the static site's Environment tab, e.g. https://noor-mock-api.onrender.com
# Vite bakes this in at build time: restart `npm run dev`, or redeploy the static site, after changing it.
VITE_API_URL= https://noor-mock-api-ab12.onrender.com
