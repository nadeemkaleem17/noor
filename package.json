{
  "name": "noor",
  "private": true,
  "description": "Rubaya store: API, admin and storefront in one workspace. The plan is in plan/ (start at plan/AGENTS.md).",
  "type": "module",
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@noor/admin --filter=noor-mock-api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck lint test && node scripts/ts-ratio.mjs",
    "route-keys": "pnpm --filter @noor/api exec tsx ../../scripts/route-keys.mjs",
    "ts-ratio": "node scripts/ts-ratio.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.0"
  }
}
